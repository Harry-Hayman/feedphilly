---
import TestimonialItem from "./TestimonialItem.astro";
import StatsGrid from "@components/ui/blocks/StatsGrid.astro";

const {
  title,
  subTitle,
  testimonials,
  statistics
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  testimonials?: Testimonial[];
  statistics?: StatProps[];
}

// TypeScript type for testimonials
type Testimonial = {
  content: string;
  author: string;
  role: string;
  avatarSrc: string;
};

// TypeScript type for stats.
type StatProps = {
  count: string;
  description: string;
};
---

<section class="section-tight">
  <!-- Title and Subtitle - Centered -->
  <div class="section-header">
    <h2 class="text-balance">
      {title}
    </h2>
    {subTitle && (
      <p class="lede mt-4">
        {subTitle}
      </p>
    )}
  </div>

  <!-- Main Content Grid -->
  <!--
    `min-w-0` matters here. Grid items default to min-width:auto, so the
    carousel's inner flex row (one 100%-wide slide per testimonial) forced the
    column to its full intrinsic width. On a 390px phone that pushed the whole
    document to 770px and produced horizontal scrolling on every page that
    renders this section.
  -->
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-16">
    <!-- Testimonials Carousel -->
    <div class="min-w-0 lg:col-span-6">
      {testimonials && testimonials.length > 0 && (
        <div class="relative">
          <!-- Carousel Container -->
          <div class="overflow-hidden rounded-xl bg-neutral-50 dark:bg-neutral-800/50">
            <div 
              id="testimonials-carousel" 
              class="flex transition-transform duration-700 ease-in-out"
            >
              {testimonials.map((testimonial, index) => (
                <div class="w-full flex-shrink-0">
                  <div class="p-8 sm:p-12">
                    <TestimonialItem 
                      content={testimonial.content} 
                      author={testimonial.author} 
                      role={testimonial.role} 
                      avatarSrc={testimonial.avatarSrc} 
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
          
          <!--
            Navigation dots. The visible dot is 12px but the button is 44px so
            it meets the minimum touch target; the padding is transparent.
          -->
          <div class="mt-6 flex justify-center" role="tablist" aria-label="Choose a testimonial">
            {testimonials.map((_, index) => (
              <button
                type="button"
                role="tab"
                class="testimonial-indicator group flex h-11 w-11 items-center justify-center"
                data-slide={index}
                aria-label={`Show testimonial ${index + 1} of ${testimonials.length}`}
                aria-selected={index === 0 ? "true" : "false"}
              >
                <span class="testimonial-dot block h-3 w-3 rounded-full bg-neutral-400 transition-colors duration-200 group-hover:bg-neutral-600 dark:bg-neutral-600 dark:group-hover:bg-neutral-400" />
              </button>
            ))}
          </div>
        </div>
      )}
    </div>

    <!--
      Statistics grid. StatsGrid renders an <li>, so it needs a real <ul>
      around it. Previously each one sat inside a plain <div>, which is the
      "List items are not contained within <ul>/<ol>" accessibility failure.
    -->
    {statistics && (
      <div class="min-w-0 lg:col-span-6">
        <ul class="grid h-full list-none grid-cols-2 gap-px overflow-hidden rounded-xl bg-neutral-200 p-0 dark:bg-neutral-700">
          {statistics.map((stat, index) => (
            <StatsGrid count={stat.count} description={stat.description} index={index}/>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .testimonial-indicator[aria-selected="true"] .testimonial-dot {
    @apply scale-125 bg-green-800 dark:bg-green-300;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.getElementById('testimonials-carousel') as HTMLElement | null;
    const indicators = document.querySelectorAll('.testimonial-indicator') as NodeListOf<HTMLElement>;
    
    if (!carousel || indicators.length === 0) return;
    
    let currentSlide = 0;
    const totalSlides = indicators.length;
    const autoScrollDelay = 7000;
    let autoScrollInterval: number | undefined;

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    function updateCarousel() {
      if (!carousel) return;

      carousel.style.transform = `translateX(${-(currentSlide * 100)}%)`;

      indicators.forEach((indicator, index) => {
        indicator.setAttribute(
          'aria-selected',
          index === currentSlide ? 'true' : 'false',
        );
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      updateCarousel();
    }

    function startAutoScroll() {
      // Never auto-advance for people who asked for reduced motion, and never
      // run the timer while the tab is hidden.
      if (reduceMotion || document.hidden) return;
      stopAutoScroll();
      autoScrollInterval = window.setInterval(nextSlide, autoScrollDelay);
    }

    function stopAutoScroll() {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = undefined;
      }
    }

    updateCarousel();
    startAutoScroll();

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentSlide = index;
        updateCarousel();
        startAutoScroll();
      });
    });

    // Pause while a pointer or keyboard focus is inside the carousel.
    carousel.addEventListener('mouseenter', stopAutoScroll);
    carousel.addEventListener('mouseleave', startAutoScroll);
    carousel.addEventListener('focusin', stopAutoScroll);
    carousel.addEventListener('focusout', startAutoScroll);

    // `beforeunload` blocks the back/forward cache. `visibilitychange` also
    // covers mobile tab switches, which `beforeunload` never fires for.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoScroll();
      else startAutoScroll();
    });
  });
</script>
