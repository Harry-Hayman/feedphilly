---
// Import the necessary dependencies
import TabNav from "@components/ui/blocks/TabNav.astro";
import TabContent from "@components/ui/blocks/TabContent.astro";
import Icon from "@components/ui/icons/Icon.astro";

// Define props from Astro
const { title, tabs } = Astro.props;

// Define TypeScript interface for tab object
interface Tab {
  heading: string;
  content: string;
  svg: string;
  src: any;
  alt: string;
  first?: boolean;
  second?: boolean;
}

// Define TypeScript interface for props
interface Props {
  title?: string;
  tabs: Tab[];
}
---

<section class="section-tight">
  <!--
    The decorative backdrop used to be `bg-neutral-100`, which is invisible on
    the current page colour. It is now a soft brand tint that actually reads as
    a panel, and the grid gap is wider so the image and the tab list are not
    crammed together.
  -->
  <div
    class="relative rounded-2xl bg-green-50/70 px-6 py-10 dark:bg-white/[.04] md:p-12"
  >
    <div
      class="relative z-10 lg:grid lg:grid-cols-12 lg:items-center lg:gap-12"
    >
      <!-- Section's heading and tab navigation -->
      <div class="mb-8 lg:order-2 lg:col-span-6 lg:col-start-7 lg:mb-0">
        <h2 class="text-balance">
          <!-- About Fragment: https://docs.astro.build/en/basics/astro-syntax/#fragments -->
          <Fragment set:html={title} />
        </h2>
        <!-- Tab navigation - use the attribute 'first' in the first TabNav for the component to work -->
        <nav class="mt-6 grid gap-2 md:mt-8" aria-label="Tabs" role="tablist">
          {
            tabs.map((tab, index) => (
              <TabNav
                id={`tabs-with-card-item-${index + 1}`}
                dataTab={`#tabs-with-card-${index + 1}`}
                aria={`tabs-with-card-${index + 1}`}
                heading={tab.heading}
                content={tab.content}
                first={tab.first}
              >
                <Icon name={tab.svg} />
              </TabNav>
            ))
          }
        </nav>
      </div>

      <!-- Contents for each tab - the 'first' attribute should be used in the first tab for that tab to be initially visible, 'second' changes the styles -->
      <div class="lg:col-span-6">
        {
          tabs.map((tab, index) => (
            <TabContent
              id={`tabs-with-card-${index + 1}`}
              aria={`tabs-with-card-item-${index + 1}`}
              src={tab.src}
              alt={tab.alt}
              first={tab.first}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
<!--Import the necessary Tabs plugin-->
<!--https://preline.co/plugins/html/tabs.html-->
<script is:inline>
  window.addEventListener('load', () => {
    const tabButtons = document.querySelectorAll('[data-hs-tab]');
    const tabPanels = document.querySelectorAll('[role="tabpanel"]');

    function showTab(targetId) {
      tabPanels.forEach(panel => {
        if (panel.id === targetId.substring(1)) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      // Update active state of buttons
      tabButtons.forEach(btn => {
        const isActive = btn.getAttribute('data-hs-tab') === targetId;
        if (isActive) {
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        }
      });
    }

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-hs-tab');
        if (targetId) {
          showTab(targetId);
        }
      });
    });

    // Initialize first tab as active
    showTab('#tabs-with-card-1');
  });
</script>
