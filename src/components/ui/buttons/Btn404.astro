---
import Icon from "@components/ui/icons/Icon.astro";
// Destructure the properties from Astro.props
const { title, id, noArrow } = Astro.props;
// Define TypeScript interface for the properties
interface Props {
  title?: string;
  id?: string;
  noArrow?: boolean;
}
// Was bg-green-400 with white text: 1.9:1 contrast, the worst pairing on the
// site. Uses the shared primary button style now.
const classes = "btn-primary group disabled:pointer-events-none disabled:opacity-50";
---

<!-- Button with dynamic title, id, and optional arrow -->
<button class={classes} id={id}>
  {title}
  <!-- Display the arrow based on the 'noArrow' property -->
  {noArrow ? null : <Icon name="arrowRight" />}
</button>
