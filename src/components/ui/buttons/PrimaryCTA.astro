---
import Icon from "@components/ui/icons/Icon.astro";
// Destructure the properties from Astro.props
const { title, url, noArrow } = Astro.props;
// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
  noArrow?: boolean;
}
// The old background was bg-green-500 (#22c55e) behind white text: a 2.3:1
// contrast ratio, well under the 4.5:1 minimum, and the site's reported
// accessibility failure. .btn-primary uses the darker brand green (5.6:1) and
// guarantees a 44px tall target.
const classes = "btn-primary group disabled:pointer-events-none disabled:opacity-50";
---

<!-- Link styled as a button, with dynamic title, URL, and optional arrow -->
<a class={classes} href={url}>
  {title}
  <!-- Display the arrow based on the 'noArrow' property -->

  {noArrow ? null : <Icon name="arrowRight" />}
</a>
