---
// Destructure the properties from Astro.props
const { title, url } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
}
// Visually subordinate to PrimaryCTA (outlined, not filled) so a screen with
// both has one obvious primary action.
const classes = "btn-secondary disabled:pointer-events-none disabled:opacity-50";
---

<!-- Styled hyperlink -->
<a class={classes} href={url}>
  {title}
</a>
