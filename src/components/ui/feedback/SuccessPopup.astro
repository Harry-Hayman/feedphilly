---
const { message = "Thank you for submitting!" } = Astro.props;

interface Props {
  message?: string;
}

declare global {
  interface Window {
    showSuccessPopup: (message: string, isError?: boolean) => void;
  }
}
---

<!--
  This component is rendered once by the footer newsletter form and again by
  the contact form, which produced two elements sharing id="success-popup" on
  /contact. `data-success-popup` marks every instance and the script targets
  the first one, so the markup stays valid however many forms a page has.
  role="status" + aria-live announces the result without stealing focus.
-->
<div
  data-success-popup
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed left-1/2 top-24 z-[60] -translate-x-1/2 transform opacity-0 transition-opacity duration-300 ease-out"
>
  <div
    data-success-popup-box
    class="rounded-lg bg-green-800 px-6 py-3 shadow-lg dark:bg-green-700"
  >
    <div class="flex items-center gap-2">
      <svg
        class="h-5 w-5 text-white"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
          clip-rule="evenodd"></path>
      </svg>
      <p class="text-sm font-medium text-white">{message}</p>
    </div>
  </div>
</div>

<script>
  let hideTimer: number | undefined;

  function showPopup(message: string, isError = false) {
    const popup = document.querySelector<HTMLElement>("[data-success-popup]");
    if (!popup) return;

    const messageEl = popup.querySelector("p");
    if (messageEl) messageEl.textContent = message;

    const box = popup.querySelector<HTMLElement>("[data-success-popup-box]");
    if (box) {
      box.classList.toggle("bg-red-700", isError);
      box.classList.toggle("dark:bg-red-600", isError);
      box.classList.toggle("bg-green-800", !isError);
      box.classList.toggle("dark:bg-green-700", !isError);
    }

    popup.classList.remove("opacity-0");
    popup.classList.add("opacity-100");

    if (hideTimer) clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => {
      popup.classList.add("opacity-0");
      popup.classList.remove("opacity-100");
    }, 5000);
  }

  // Add to window for access from inline scripts
  window.showSuccessPopup = showPopup;

  // Handle form submissions
  document.addEventListener("DOMContentLoaded", () => {
    const forms = document.querySelectorAll<HTMLFormElement>(
      "form[data-show-success]",
    );
    forms.forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitButton = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.classList.add("opacity-50");
        }

        const formData = new FormData(form);

        try {
          // Google Apps Script requires CORS preflight
          const response = await fetch(form.action, {
            method: "POST",
            mode: "cors",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded",
            },
            body: new URLSearchParams(formData as any).toString(),
          });

          // Google Apps Script returns a redirect on success
          // Check if we got a redirect or ok status
          if (response.ok || response.redirected) {
            showPopup(form.dataset.successMessage || "Submission successful!");
            form.reset();
          } else {
            throw new Error("Submission failed");
          }
        } catch (error) {
          console.error("Error:", error);
          showPopup("Sorry, something went wrong. Please try again.", true);
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.classList.remove("opacity-50");
          }
        }
      });
    });
  });
</script>
