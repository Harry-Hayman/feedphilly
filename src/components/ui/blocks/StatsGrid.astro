---
const { count, description } = Astro.props;

interface Props {
  count: string;
  description: string;
  index?: number;
}
---

<li class="flex flex-col bg-white p-6 dark:bg-neutral-800 sm:p-8">
  <div
    class="mb-2 flex items-end gap-x-2 text-3xl font-bold text-neutral-900 dark:text-neutral-100 sm:text-5xl"
  >
    {/*
      The arrow used to appear on items 1 and 2 only, with no rule behind it,
      which read as a rendering bug. It is gone: the numbers carry themselves.
    */}
    {count}
  </div>
  <p class="text-sm text-neutral-600 dark:text-neutral-400 sm:text-base">
    {description}
  </p>
</li>
