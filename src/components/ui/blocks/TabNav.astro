---
// Extract properties from Astro.props
const { aria, dataTab, id, heading, content, first } = Astro.props;

// Define TypeScript interface for properties
interface Props {
  dataTab: string;
  id: string;
  aria: string;
  heading?: string;
  content?: string;
  first?: boolean;
}

// The active tab now gets a solid surface and a green edge marker, so which
// panel is showing is obvious. Previously the active state was a pale green
// wash that was nearly identical to the hover state.
const buttonClasses = `
  group w-full cursor-pointer rounded-xl border-s-4 border-transparent p-5 text-start
  transition-colors duration-200
  ${first ? "active" : ""}
  hover:bg-white/70 dark:hover:bg-neutral-700/50
  group-[.active]:bg-white dark:group-[.active]:bg-neutral-700
  [&.active]:border-green-700 [&.active]:bg-white [&.active]:shadow-sm
  dark:[&.active]:border-green-400 dark:[&.active]:bg-neutral-700
`;
---

<button
  type="button"
  class={buttonClasses}
  id={id}
  data-hs-tab={dataTab}
  aria-controls={aria}
  role="tab"
>
  <span class="flex">
    <slot />
    <span class="ms-4 grow">
      <span
        class="block text-lg font-bold text-neutral-900 dark:text-neutral-100 [.active_&]:text-green-900 dark:[.active_&]:text-green-300"
      >
        {heading}
      </span>
      <span
        class="mt-2 block text-base text-neutral-700 dark:text-neutral-300"
      >
        {content}
      </span>
    </span>
  </span>
</button>
