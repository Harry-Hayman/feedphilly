---
// Import necessary components
import { Image } from "astro:assets";

import type { CollectionEntry } from "astro:content";

const { blogEntry } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<"blog">;
}
---

<div class="flex-shrink-0">
  <!-- alt="" because the author's name is right next to it in text; a second
       announcement of the same name is noise for screen reader users. -->
  <Image
    class="size-10 rounded-full object-cover sm:h-14 sm:w-14"
    src={blogEntry.data.authorImage}
    alt=""
    width={56}
    height={56}
    draggable={"false"}
    loading="lazy"
    decoding="async"
    format={"avif"}
  />
</div>
