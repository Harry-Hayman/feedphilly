---
// Import all required components and utilities
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate, generateSlug } from "@utils/utils";
import AvatarBlogLarge from "@components/ui/avatars/AvatarBlogLarge.astro";

interface Props {
  blogEntry: CollectionEntry<"blog">;
}

const { blogEntry } = Astro.props;

// Early return if no blog entry is provided
if (!blogEntry) return null;

const href = `/blog/${generateSlug(blogEntry.id)}/`;
---

<!--
  The featured post. The heading used to render `description` instead of
  `title`, so the newest article was introduced by a wall of summary text with
  no headline at all.
-->
<article
  class="grid items-center gap-8 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-800 sm:grid-cols-2 sm:gap-12 sm:p-8"
>
  <div class="sm:order-2">
    {
      blogEntry.data.cardImage && (
        <Image
          class="aspect-[4/3] w-full rounded-xl object-cover"
          src={blogEntry.data.cardImage}
          alt={blogEntry.data.cardImageAlt || ""}
          width={800}
          height={600}
          widths={[420, 640, 800]}
          sizes="(min-width: 640px) 32rem, 92vw"
          draggable={"false"}
          loading="eager"
          fetchpriority="high"
          format={"avif"}
        />
      )
    }
  </div>

  <div class="sm:order-1">
    <p
      class="mb-3 inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-bold uppercase tracking-wide text-green-900 dark:bg-green-900/50 dark:text-green-100"
    >
      Latest article
    </p>
    <h2
      class="text-balance text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 lg:text-3xl lg:leading-tight"
    >
      <a class="hover:underline" href={href}>
        {blogEntry.data.title}
      </a>
    </h2>
    <p class="mt-4 text-pretty text-neutral-700 dark:text-neutral-300">
      {blogEntry.data.description}
    </p>

    <div class="mt-6 flex items-center">
      <AvatarBlogLarge blogEntry={blogEntry} />

      <div class="ms-3 sm:ms-4">
        <p class="font-bold text-neutral-900 dark:text-neutral-100">
          {blogEntry.data.author}
        </p>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          {formatDate(blogEntry.data.pubDate)}
        </p>
      </div>
    </div>

    <div class="mt-6">
      <!-- The accessible name carries the article title. "Read more" on its
           own tells a screen reader user, and a search engine, nothing about
           where the link goes. -->
      <a class="btn-primary" href={href} data-astro-prefetch>
        Read the article<span class="sr-only">: {blogEntry.data.title}</span>
      </a>
    </div>
  </div>
</article>
