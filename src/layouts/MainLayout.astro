---
// Importing necessary components and styles
import Meta from "@components/Meta.astro";
import Navbar from "@components/sections/Navbar.astro";
import FooterSection from "@components/sections/FooterSection.astro";
import { SITE } from "@data/constants";
import { getImage } from "astro:assets";
import "../styles/global.css";

// Setting expected props
const {
  title = SITE.title,
  meta,
  structuredData,
  lang = "en",
  ogMeta,
  preloadImage,
  preloadImageSizes = "(min-width: 1024px) 42rem, (min-width: 640px) 460px, 90vw",
  preloadImageWidths = [340, 460, 672, 900],
  preloadImageDimensions = { width: 672, height: 504 },
} = Astro.props;

// Interface to type-check the properties
interface Props {
  title?: string;
  meta?: string;
  /** A single JSON-LD object, or several to publish side by side. */
  structuredData?: object | object[];
  lang?: string;
  ogMeta?: {
    title: string;
    description: string;
    image: any;
    url: string;
  };
  /**
   * The page's LCP image. Preloaded in <head> so the browser starts fetching
   * it before it has parsed down to the <img>, which is what the
   * "LCP request discovery" audit asks for. Pass the same imported image the
   * page renders.
   */
  preloadImage?: ImageMetadata;
  /**
   * These must match the widths/sizes/dimensions the page's own <Image> uses.
   * If they differ, the browser preloads one file and then downloads a second
   * one for the actual <img>, which is slower than not preloading at all.
   */
  preloadImageSizes?: string;
  preloadImageWidths?: number[];
  preloadImageDimensions?: { width: number; height: number };
}

// Build the same responsive set the hero renders, so the preload matches the
// request the <img> will make instead of adding a second, unused download.
const heroPreload = preloadImage
  ? await getImage({
      src: preloadImage,
      width: preloadImageDimensions.width,
      height: preloadImageDimensions.height,
      widths: preloadImageWidths,
      sizes: preloadImageSizes,
      format: "avif",
    })
  : null;
---

<!doctype html>
<html lang={lang} class="scroll-smooth scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Adding metadata to the HTML document -->
    <Meta meta={meta} structuredData={structuredData} ogMeta={ogMeta} />
    <!-- Define the title of the page -->
    <title>{title}</title>
    {
      heroPreload && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={heroPreload.src}
          imagesrcset={heroPreload.srcSet.attribute}
          imagesizes={preloadImageSizes}
          fetchpriority="high"
        />
      )
    }
    <script is:inline>
      // Script to handle dark mode. It will check if the theme is stored in localStorage or if dark theme is preferred by system settings
      if (
        localStorage.getItem("hs_theme") === "dark" ||
        (!("hs_theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="selection:bg-green-200 selection:text-neutral-900">
    <a
      class="sr-only rounded-lg bg-white px-4 py-3 font-semibold text-green-900 focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:shadow-lg"
      href="#main-content"
    >
      Skip to main content
    </a>
    <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
      <Navbar />
      <main id="main-content" class="min-h-screen">
        <slot />
      </main>
      <FooterSection />
    </div>
    <!--
      The Lenis smooth-scroll script used to load here. It cost ~14 KB of
      JavaScript, ran a requestAnimationFrame loop for the entire life of the
      page, and took scrolling away from the browser. Tailwind's `scroll-smooth`
      on <html> gives smooth anchor scrolling for free, and the browser turns it
      off automatically when the visitor prefers reduced motion.
    -->
  </body>
</html>
