---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import FaqSection from "@components/sections/FaqSection.astro";
import { FAQS, ORGANIZATION_SCHEMA, SOCIAL_PROFILES } from "@data/constants";
import heroImage from "@images/real_images/20250212_104744.jpeg";
import donationImage from "@images/real_images/20250212_104744.jpeg";
import teamImage from "@images/real_images/20250212_104744.jpeg";
import warehouseImage from "@images/real_images/IMG_0483.jpeg";
import truckImage from "@images/real_images/20250212_104744.jpeg";

const features = [
  {
    heading: "Collaboration",
    content:
      "Nonprofits, businesses, government, healthcare, and community leaders at the same table, working on the same problems.",
    svg: "groups",
  },
  {
    heading: "Policy Advocacy",
    content:
      "We push for policies that make healthy food easier to grow, buy, and share across the region.",
    svg: "chart",
  },
  {
    heading: "Community Awareness",
    content:
      "Workshops, events, and partnerships that help neighbors understand the problem and join the work.",
    svg: "heart",
  },
  {
    heading: "Strategic Partnerships",
    content:
      "Public-private partnerships that turn good intentions into programs that last.",
    svg: "leaf",
  },
];

// Where the coalition is headed. Harry's list, 2026-08: these are becoming
// central to the work, not side projects.
const futureFocus = [
  {
    heading: "Controlled Environment Agriculture",
    content: "Growing food year-round, close to the people who eat it.",
  },
  {
    heading: "Food as Medicine",
    content: "Treating healthy food as healthcare, because it is.",
  },
  {
    heading: "Regional Food Infrastructure",
    content:
      "The farms, kitchens, storage, and transport a resilient region runs on.",
  },
  {
    heading: "Workforce Development",
    content:
      "Training people for real careers in food, agriculture, and hospitality.",
  },
  {
    heading: "Food Innovation",
    content: "New ways to grow, process, and get food where it needs to go.",
  },
  {
    heading: "Artificial Intelligence",
    content:
      "Using AI to spot gaps, match resources to need, and make the food system smarter.",
  },
  {
    heading: "CivicOS",
    content:
      "Civic technology that connects the people, programs, and data behind this work.",
  },
  {
    heading: "Public-Private Partnerships",
    content:
      "Government, business, and community building things together that none could build alone.",
  },
  {
    heading: "Data-Driven Decision Making",
    content:
      "Decisions based on what the numbers actually say, not on assumptions.",
  },
];

// Search Console shows this page collecting impressions and no clicks for
// "food insecurity philadelphia", "food insecurity in philadelphia" and
// "philadelphia food insecurity". The title and description now lead with that
// phrasing and say what the organisation actually does, rather than repeating
// the tagline.
const pageTitle =
  "Food Insecurity in Philadelphia | Feed Philly Coalition";
const pageDescription =
  "Food insecurity affects thousands of Philadelphia families, particularly children. Feed Philly Coalition unites nonprofits, businesses, schools and policymakers behind collaborative, data-driven solutions. See our work and get involved.";

const ogMeta = {
  title: "Fighting Food Insecurity in Philadelphia",
  description: pageDescription,
  image: heroImage,
  url: Astro.url.origin + Astro.url.pathname,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${Astro.url.origin}/#faq`,
  mainEntity: FAQS.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${Astro.url.origin}/#webpage`,
  url: Astro.url.origin + "/",
  name: pageTitle,
  description: pageDescription,
  inLanguage: "en-US",
  about: { "@id": `${Astro.url.origin}/#organization` },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${Astro.url.origin}/#website`,
    url: Astro.url.origin,
    name: "Feed Philly Coalition",
  },
};

const founderSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://harryhayman.com/#person",
      name: "Harry G. Hayman IV",
      alternateName: ["Harry Hayman", "Harrison Graham Hayman IV"],
      url: "https://harryhayman.com",
      image: "https://harryhayman.com/banner.png",
      description:
        "Philadelphia business leader, hospitality entrepreneur, and philanthropist known for work in restaurant industry and community development through Feed Philly Coalition and The Philadelphia Jazz Experience.",
      jobTitle: "Hospitality Entrepreneur & Community Leader",
      worksFor: {
        "@type": "Organization",
        name: "Gemini Hospitality Consultants",
      },
      founder: [
        {
          "@type": "Organization",
          name: "Gemini Hospitality Consultants",
          url: "https://harryhaymangemini.com/",
          description:
            "Strategic consulting services for restaurants and hospitality businesses",
        },
        {
          "@type": "Organization",
          name: "Philadelphia Jazz Experience",
          url: "https://philadelphiajazzexperience.org",
          description:
            "Preserving and promoting Philadelphia's rich jazz heritage",
        },
        {
          "@type": "Organization",
          name: "Veggie Graffiti",
          url: "https://veggiegraffiti.com",
          description:
            "Urban farming initiative combining hydroponic technology with sustainable practices",
        },
        {
          "@type": "Organization",
          name: "Feed Philly Coalition",
          url: "https://feedphillycoalition.org",
          description: "Community initiative addressing food insecurity",
        },
        {
          "@type": "Organization",
          name: "Harry Hayman Creative",
          url: "https://harryhaymancreative.com/",
          description:
            "Creative agency specializing in branding and marketing for hospitality businesses",
        },
        {
          "@type": "Organization",
          name: "I Am Hungry in Philly",
          url: "https://iamhungryinphilly.org",
          description:
            "Connecting Philadelphia's hungry with local food resources",
        },
        {
          "@type": "Organization",
          name: "Another Three Hearts Experience",
          url: "https://another3heartsexperience.com/",
          description:
            "Creating unique hospitality experiences combining culinary excellence with cultural enrichment",
        },
      ],
      sameAs: [
        "https://www.facebook.com/HaymanHG/",
        "https://www.pinterest.com/hghayman1/",
        "https://www.instagram.com/harryhayman4",
        "https://x.com/HGHayman",
        "https://www.threads.com/@harryhayman4",
        "https://bsky.app/profile/harryhayman.bsky.social",
        "https://www.youtube.com/@harryhayman1467/shorts",
        "https://www.linkedin.com/in/harrisongrahamhaymaniv/",
      ],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Philadelphia",
        addressRegion: "PA",
        addressCountry: "US",
      },
      knowsAbout: [
        "Restaurant Management",
        "Hospitality Industry",
        "Community Development",
        "Food Justice",
        "Jazz Music",
        "Philanthropy",
        "Business Consulting",
        "Urban Agriculture",
        "Creative Marketing",
      ],
};
---

<MainLayout
  title={pageTitle}
  meta={pageDescription}
  ogMeta={ogMeta}
  preloadImage={heroImage}
  structuredData={[
    { ...ORGANIZATION_SCHEMA, sameAs: SOCIAL_PROFILES, founder: { "@id": founderSchema["@id"], "@type": "Person", name: "Harry G. Hayman IV" } },
    webPageSchema,
    faqSchema,
    founderSchema,
  ]}
>
  <HeroSection
    title="Fighting Food Insecurity in <span class='text-green-800 dark:text-green-300'>Philadelphia</span>"
    subTitle="A coalition of nonprofits, businesses, government, healthcare, education, agriculture, philanthropy, and community leaders working together to build a stronger, healthier, more resilient regional food system."
    primaryBtn="Get Involved"
    primaryBtnURL="/get-involved"
    secondaryBtn="See Our Work"
    secondaryBtnURL="/what-we-do"
    src={heroImage}
    alt="Volunteers standing behind boxes of donated fresh produce at a food distribution"
  />

  <!--
    The answer to "what is this?" sits in the hero subtitle; this section
    carries the why. Answer engines quote short factual statements near the
    top of a document far more readily than a hero headline plus tagline, so
    the definition is repeated here in plain prose.
  -->
  <section class="section-tight" aria-labelledby="mission-heading">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="mission-heading" class="text-balance">
        Why this coalition exists
      </h2>
      <p class="lede mt-4">
        The Feed Philly Coalition is a coalition of nonprofits, businesses,
        government, healthcare, education, agriculture, philanthropy, and
        community leaders working together to build a stronger, healthier, more
        resilient regional food system.
      </p>
      <p class="mt-4 text-neutral-700 dark:text-neutral-300">
        We got here the slow way: years of volunteering, feeding people, packing
        boxes, supporting nonprofits, and showing up when a crisis hit. The
        lesson from all of it is simple. No single organization can solve these
        challenges alone. This coalition exists because collaboration, not
        competition, is how lasting, systemic change happens.
      </p>
    </div>
  </section>

  <FeaturesGeneral
    title="How the coalition fights food insecurity in Philadelphia"
    subTitle="Lasting change comes from people working together: on policy, in neighborhoods, and across sectors."
    src={donationImage}
    alt="Feed Philly Coalition volunteers standing behind boxes of packed food"
    features={features}
  />

  <!-- Where the work is going -->
  <section class="section-tight" aria-labelledby="future-heading">
    <div class="section-header">
      <h2 id="future-heading" class="text-balance">
        Where we're <span class="text-green-800 dark:text-green-300">headed</span>
      </h2>
      <p class="lede mt-4">
        These aren't side projects. They're where the food system is going, and
        the coalition is building toward them now.
      </p>
    </div>
    <ul class="grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        futureFocus.map((item) => (
          <li class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg dark:border-neutral-700 dark:bg-neutral-800">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
              {item.heading}
            </h3>
            <p class="mt-2 text-neutral-700 dark:text-neutral-300">
              {item.content}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <FeaturesNavs
    title="How We Make a <span class='text-green-800 dark:text-green-300'>Difference</span>"
    tabs={[
      {
        heading: "Policy Advocacy",
        content:
          "We work with elected officials and city agencies on policies that address food insecurity and promote equity.",
        svg: "box",
        src: warehouseImage,
        alt: "A Feed Philly Coalition meeting around a conference table, with a place card reading Harry G. Hayman",
        first: true,
      },
      {
        heading: "Community Awareness",
        content:
          "We raise awareness about food insecurity through educational campaigns, events, and partnerships.",
        svg: "users",
        // Was a second copy of the warehouse photo. Every tab now shows a
        // different image, which is the point of a tabbed panel.
        src: teamImage,
        alt: "Volunteers standing behind boxes of donated fresh produce at a food distribution",
      },
      {
        heading: "Collaboration",
        content:
          "We collaborate with organizations and coalitions to maximize our positive impact in Philadelphia.",
        svg: "truck",
        src: truckImage,
        alt: "Volunteers working together over boxes of donated produce",
      },
    ]}
  />

  <TestimonialsSection
    title="Our Impact"
    subTitle="A few numbers that show what collaboration makes possible."
    testimonials={[
      {
        content:
          "We've spent years volunteering, feeding people, packing boxes, supporting nonprofits, and responding to crises. The lesson we've learned is that no single organization can solve these challenges alone. Collaboration, not competition, is how we create lasting, systemic change.",
        author: "Harry G. Hayman IV",
        role: "Feed Philly Coalition",
        avatarSrc: "/src/images/blog/members/harryhayman_founder.jpg",
      },
    ]}
    statistics={[
      {
        count: "25+",
        description: "organizations collaborating",
      },
      {
        count: "25+",
        description: "policy initiatives supported",
      },
      {
        count: "100,000+",
        description:
          "people reached through coalition partners and community engagement",
      },
    ]}
  />

  <FaqSection
    title="Food insecurity in Philadelphia: common questions"
    intro="Short answers about the coalition and its work in the city."
    faqs={FAQS}
  />
</MainLayout>
