---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import FaqSection from "@components/sections/FaqSection.astro";
import { FAQS, ORGANIZATION_SCHEMA, SOCIAL_PROFILES } from "@data/constants";
import heroImage from "@images/feedphilly/hero1.png";
import donationImage from "@images/real_images/20250212_104744.jpeg";
import teamImage from "@images/feedphilly/feed_philly_team.jpg";
import warehouseImage from "@images/real_images/IMG_0483.jpeg";
import truckImage from "@images/feedphilly/feed_philly_truck1.jpg";

const features = [
  {
    heading: "Collaboration",
    content:
      "We bring together individuals, nonprofits, businesses, and policymakers to drive community awareness and policy change for lasting impact.",
    svg: "groups",
  },
  {
    heading: "Policy Advocacy",
    content:
      "We work at the government level to advocate for policies that address food insecurity and promote equitable access.",
    svg: "chart",
  },
  {
    heading: "Community Awareness",
    content:
      "We educate and empower communities through workshops, events, and partnerships with other organizations.",
    svg: "heart",
  },
  {
    heading: "Strategic Partnerships",
    content:
      "Our coalition collaborates with organizations to create positive, sustainable change for Philadelphia.",
    svg: "leaf",
  },
];

// Search Console shows this page collecting impressions and no clicks for
// "food insecurity philadelphia", "food insecurity in philadelphia" and
// "philadelphia food insecurity". The title and description now lead with that
// phrasing and say what the organisation actually does, rather than repeating
// the tagline.
const pageTitle =
  "Food Insecurity in Philadelphia | Feed Philly Coalition";
const pageDescription =
  "Food insecurity affects thousands of Philadelphia families, particularly children. Feed Philly Coalition unites nonprofits, businesses, schools and policymakers behind collaborative, data-driven solutions. See our work and get involved.";

const ogMeta = {
  title: "Fighting Food Insecurity in Philadelphia",
  description: pageDescription,
  image: heroImage,
  url: Astro.url.origin + Astro.url.pathname,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${Astro.url.origin}/#faq`,
  mainEntity: FAQS.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${Astro.url.origin}/#webpage`,
  url: Astro.url.origin + "/",
  name: pageTitle,
  description: pageDescription,
  inLanguage: "en-US",
  about: { "@id": `${Astro.url.origin}/#organization` },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${Astro.url.origin}/#website`,
    url: Astro.url.origin,
    name: "Feed Philly Coalition",
  },
};

const founderSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://harryhayman.com/#person",
      name: "Harry Hayman",
      alternateName: "Harrison Graham Hayman IV",
      url: "https://harryhayman.com",
      image: "https://harryhayman.com/banner.png",
      description:
        "Philadelphia business leader, hospitality entrepreneur, and philanthropist known for work in restaurant industry and community development through Feed Philly Coalition and The Philadelphia Jazz Experience.",
      jobTitle: "Hospitality Entrepreneur & Community Leader",
      worksFor: {
        "@type": "Organization",
        name: "Gemini Hospitality Consultants",
      },
      founder: [
        {
          "@type": "Organization",
          name: "Gemini Hospitality Consultants",
          url: "https://harryhaymangemini.com/",
          description:
            "Strategic consulting services for restaurants and hospitality businesses",
        },
        {
          "@type": "Organization",
          name: "Philadelphia Jazz Experience",
          url: "https://philadelphiajazzexperience.org",
          description:
            "Preserving and promoting Philadelphia's rich jazz heritage",
        },
        {
          "@type": "Organization",
          name: "Veggie Graffiti",
          url: "https://veggiegraffiti.com",
          description:
            "Urban farming initiative combining hydroponic technology with sustainable practices",
        },
        {
          "@type": "Organization",
          name: "Feed Philly Coalition",
          url: "https://feedphillycoalition.org",
          description: "Community initiative addressing food insecurity",
        },
        {
          "@type": "Organization",
          name: "Harry Hayman Creative",
          url: "https://harryhaymancreative.com/",
          description:
            "Creative agency specializing in branding and marketing for hospitality businesses",
        },
        {
          "@type": "Organization",
          name: "I Am Hungry in Philly",
          url: "https://iamhungryinphilly.org",
          description:
            "Connecting Philadelphia's hungry with local food resources",
        },
        {
          "@type": "Organization",
          name: "Another Three Hearts Experience",
          url: "https://another3heartsexperience.com/",
          description:
            "Creating unique hospitality experiences combining culinary excellence with cultural enrichment",
        },
      ],
      sameAs: [
        "https://www.facebook.com/HaymanHG/",
        "https://www.pinterest.com/hghayman1/",
        "https://www.instagram.com/harryhayman4",
        "https://x.com/HGHayman",
        "https://www.threads.com/@harryhayman4",
        "https://bsky.app/profile/harryhayman.bsky.social",
        "https://www.youtube.com/@harryhayman1467/shorts",
        "https://www.linkedin.com/in/harrisongrahamhaymaniv/",
      ],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Philadelphia",
        addressRegion: "PA",
        addressCountry: "US",
      },
      knowsAbout: [
        "Restaurant Management",
        "Hospitality Industry",
        "Community Development",
        "Food Justice",
        "Jazz Music",
        "Philanthropy",
        "Business Consulting",
        "Urban Agriculture",
        "Creative Marketing",
      ],
};
---

<MainLayout
  title={pageTitle}
  meta={pageDescription}
  ogMeta={ogMeta}
  preloadImage={heroImage}
  structuredData={[
    { ...ORGANIZATION_SCHEMA, sameAs: SOCIAL_PROFILES, founder: { "@id": founderSchema["@id"], "@type": "Person", name: "Harry Hayman" } },
    webPageSchema,
    faqSchema,
    founderSchema,
  ]}
>
  <HeroSection
    title="Fighting Food Insecurity in <span class='text-green-800 dark:text-green-300'>Philadelphia</span>"
    subTitle="Together, we can create a city where everyone has access to healthy, nutritious food."
    primaryBtn="Get Involved"
    primaryBtnURL="/get-involved"
    secondaryBtn="See Our Work"
    secondaryBtnURL="/what-we-do"
    src={heroImage}
    alt="An illustration of a Philadelphia neighbourhood market, with neighbours sharing fresh produce"
  />

  <!--
    Mission summary, high on the page, in plain prose. Answer engines quote
    short factual statements near the top of a document far more readily than
    they quote a hero headline plus a tagline.
  -->
  <section class="section-tight" aria-labelledby="mission-heading">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="mission-heading" class="text-balance">
        What Feed Philly Coalition does
      </h2>
      <p class="lede mt-4">
        Feed Philly Coalition is a Philadelphia coalition working on food
        insecurity. It brings together individuals, nonprofits, businesses, and
        policymakers behind collaborative, data-driven solutions and sustainable
        community programs, so that everyone in the city has access to healthy,
        nutritious food. It was founded by Harry Hayman.
      </p>
    </div>
  </section>

  <FeaturesGeneral
    title="How the coalition fights food insecurity in Philadelphia"
    subTitle="Feed Philly Coalition is dedicated to creating lasting change through community awareness, policy making, and collaboration with organizations."
    src={donationImage}
    alt="Feed Philly Coalition volunteers standing behind boxes of packed food"
    features={features}
  />

  <FeaturesNavs
    title="How We Make a <span class='text-green-800 dark:text-green-300'>Difference</span>"
    tabs={[
      {
        heading: "Policy Advocacy",
        content:
          "We engage with government officials and stakeholders to advocate for policies that address food insecurity and promote equity.",
        svg: "box",
        src: warehouseImage,
        alt: "A Feed Philly Coalition meeting around a conference table, with a place card reading Harry G. Hayman",
        first: true,
      },
      {
        heading: "Community Awareness",
        content:
          "We raise awareness about food insecurity through educational campaigns, events, and partnerships.",
        svg: "users",
        // Was a second copy of the warehouse photo. Every tab now shows a
        // different image, which is the point of a tabbed panel.
        src: teamImage,
        alt: "Feed Philly Coalition volunteers together in branded shirts",
      },
      {
        heading: "Collaboration",
        content:
          "We collaborate with organizations and coalitions to maximize our positive impact in Philadelphia.",
        svg: "truck",
        src: truckImage,
        alt: "A Feed Philly Coalition delivery truck loaded for a distribution run",
      },
    ]}
  />

  <TestimonialsSection
    title="Making Real Change"
    subTitle="See how Feed Philly Coalition is driving policy and collaboration for positive impact."
    testimonials={[
      {
        content:
          "Feed Philly Coalition's work in policy making and community awareness has helped bring organizations together for real change in Philadelphia.",
        author: "Maria Rodriguez",
        role: "Community Leader | North Philadelphia",
        avatarSrc:
          "https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400&h=400&fit=crop&crop=face",
      },
      {
        content:
          "The coalition's collaborative approach to fighting food insecurity has made a tremendous impact in our community. Their dedication to policy change is inspiring.",
        author: "David Greensburg",
        role: "Communications Director | Feed Philly Coalition",
        avatarSrc:
          "/src/images/blog/members/David Greensburg-Communications I.jpg",
      },
      {
        content:
          "I founded Feed Philly Coalition with the vision of bringing together diverse voices to tackle food insecurity. Seeing our collaborative efforts create real policy change and community impact has been incredibly rewarding.",
        author: "Harry Hayman",
        role: "Founder | Feed Philly Coalition",
        avatarSrc: "/src/images/blog/members/harryhayman_founder.jpg",
      },
      {
        content:
          "The data-driven approach and commitment to addressing root causes of food insecurity sets this coalition apart. Real change is happening.",
        author: "Sarah Johnson",
        role: "Policy Advocate | Philadelphia Food Alliance",
        avatarSrc:
          "https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=400&h=400&fit=crop&crop=face",
      },
    ]}
    statistics={[
      {
        count: "25+",
        description: "organizations collaborating for policy change",
      },
      {
        count: "10+",
        description: "community awareness campaigns launched",
      },
      {
        count: "5+",
        description: "policy initiatives supported",
      },
      {
        count: "1k+",
        description: "people reached",
      },
    ]}
  />

  <FaqSection
    title="Food insecurity in Philadelphia: common questions"
    intro="Short answers about the coalition and its work in the city."
    faqs={FAQS}
  />
</MainLayout>
