---
export const prerender = true;
// Import necessary components and utilities
import MainLayout from "@/layouts/MainLayout.astro";
import CardRelated from "@components/ui/cards/CardRelated.astro";
import Bookmark from "@components/ui/buttons/Bookmark.astro";
import SocialShare from "@components/ui/buttons/SocialShare.astro";
import PostFeedback from "@components/ui/feedback/PostFeedback.astro";
import { Image } from "astro:assets";
import { capitalize, formatDate, calculateReadTime } from "@utils/utils";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { SITE, ORGANIZATION_SCHEMA } from "@data/constants";

interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = (await getCollection("blog")) as CollectionEntry<"blog">[];
  // The content layer already derives an id that matches the published URL
  // (file name, lowercased, whitespace collapsed to hyphens).
  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { id: post.id },
    props: { post },
  }));
}

// Get post from props
const { post } = Astro.props;
const { Content } = await render(post);

// Calculate read time if not provided in frontmatter
const readTime = post.data.readTime ?? calculateReadTime(post.body ?? "");

// Pick a small set of related posts instead of rendering every other article.
const posts = (await getCollection("blog")) as CollectionEntry<"blog">[];
const tags = new Set(post.data.tags ?? []);
const relatedPosts = posts
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => {
    const shared = (entry: CollectionEntry<"blog">) =>
      (entry.data.tags ?? []).filter((tag: string) => tags.has(tag)).length;
    const byTags = shared(b) - shared(a);
    if (byTags !== 0) return byTags;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);

const pageTitle = `${post.data.title} | ${SITE.title}`;
const ogMeta = {
  title: post.data.title,
  description: post.data.description || (post.body ?? "").slice(0, 160) + "...",
  image: post.data.cardImage || post.data.authorImage,
  url: Astro.url.origin + Astro.url.pathname,
};
---

<MainLayout
  title={pageTitle}
  meta={ogMeta.description}
  ogMeta={ogMeta}
  preloadImage={post.data.cardImage}
  preloadImageSizes="(min-width: 768px) 42rem, 92vw"
  preloadImageWidths={[480, 768, 1024]}
  preloadImageDimensions={{ width: 768, height: 512 }}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "@id": `${ogMeta.url}#article`,
      mainEntityOfPage: ogMeta.url,
      headline: post.data.title,
      description: ogMeta.description,
      image: Astro.url.origin + ogMeta.image.src,
      articleSection: post.data.tags?.[0],
      keywords: post.data.tags?.join(", "),
      wordCount: (post.body ?? "").split(/\s+/).filter(Boolean).length,
      inLanguage: "en-US",
      author: { "@type": "Person", name: post.data.author },
      publisher: { "@id": `${Astro.url.origin}/#organization` },
      datePublished: post.data.pubDate.toISOString(),
      dateModified: post.data.pubDate.toISOString(),
      url: ogMeta.url,
    },
    // Breadcrumbs give the article a visible path in search results instead of
    // a bare URL.
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${Astro.url.origin}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Articles",
          item: `${Astro.url.origin}/blog`,
        },
        { "@type": "ListItem", position: 3, name: post.data.title },
      ],
    },
    ORGANIZATION_SCHEMA,
  ]}
>
  <section class="mx-auto max-w-3xl px-4 pb-12 pt-6 sm:px-6 lg:px-8 lg:pt-10">
    <div class="max-w-2xl">
      <div class="mb-6 flex items-center justify-between">
        <div class="flex w-full gap-x-5 sm:items-center sm:gap-x-3">
          <!-- alt="" because the author's name is announced right next to it.
               width/height doubled for retina: at 48x48 the source was being
               downscaled below the rendered density. -->
          <Image
            class="inline-block h-12 w-12 rounded-full object-cover ring-2 ring-white dark:ring-neutral-800"
            src={post.data.authorImage}
            alt=""
            width={96}
            height={96}
            densities={[1, 2]}
            loading="eager"
            decoding="async"
            format="avif"
          />
          <div class="grow">
            <div class="flex items-center justify-between gap-x-2">
              <div>
                <div
                  class="hs-tooltip inline-block [--placement:bottom] [--trigger:hover]"
                >
                  <!--Post metadata and author info-->
                  <span
                    class="font-bold text-neutral-700 dark:text-neutral-300"
                  >
                    {post.data.author}
                  </span>
                </div>
                <!-- was text-neutral-500 (#737373) at 12px: 4.36:1 on the page
                     background, just under the 4.5:1 minimum. -->
                <ul class="text-xs text-neutral-600 dark:text-neutral-400">
                  <li
                    class="relative inline-block pe-6 before:absolute before:end-2 before:top-1/2 before:size-1 before:-translate-y-1/2 before:rounded-full before:bg-neutral-300 last:pe-0 last-of-type:before:hidden dark:text-neutral-400 dark:before:bg-neutral-600"
                  >
                    {formatDate(post.data.pubDate)}
                  </li>
                  <li
                    class="relative inline-block pe-6 before:absolute before:end-2 before:top-1/2 before:size-1 before:-translate-y-1/2 before:rounded-full before:bg-neutral-300 last:pe-0 last-of-type:before:hidden dark:text-neutral-400 dark:before:bg-neutral-600"
                  >
                    {readTime} min read
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!--Blog post title. This was an <h2>: the article pages had no <h1>
          at all, which breaks the heading outline and costs the page its
          strongest on-page ranking signal.-->
      <h1 class="mb-4 text-balance text-3xl font-bold md:text-4xl">
        {post.data.title}
      </h1>
      <p class="lede mb-6">{post.data.description}</p>
      <!--Blog post contents-->
      <div class="mb-5 space-y-5 md:mb-8 md:space-y-8">
        {
          post.data.cardImage && (
            <Image
              class="mb-6 aspect-[3/2] w-full rounded-xl object-cover"
              src={post.data.cardImage}
              alt={post.data.cardImageAlt || ""}
              draggable={"false"}
              format={"avif"}
              width={768}
              height={512}
              widths={[480, 768, 1024]}
              sizes="(min-width: 768px) 42rem, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          )
        }
        <div class="prose prose-neutral max-w-none dark:prose-invert">
          <Content />
        </div>
      </div>
      <div
        class="mx-auto grid max-w-screen-lg gap-y-5 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
      >
        <!--Blog post tags-->
        <div
          class="flex flex-wrap gap-x-2 gap-y-1 sm:flex-nowrap sm:items-center sm:gap-y-0"
        >
          {
            post.data.tags?.map((tag: string) => (
              <span class="inline-flex items-center gap-x-1.5 rounded-lg bg-neutral-400/30 px-3 py-1.5 text-xs font-medium text-neutral-700 outline-none focus:outline-none focus-visible:outline-none focus-visible:ring dark:bg-neutral-700/60 dark:text-neutral-300">
                {capitalize(tag)}
              </span>
            ))
          }
        </div>
        <!--Bookmark and Share buttons-->
        <div class="flex items-center justify-end gap-x-1.5">
          <Bookmark />
          <div
            class="mx-3 block h-4 border-e border-neutral-400 dark:border-neutral-500"
          >
          </div>
          <div class="inline-flex">
            <SocialShare pageTitle={post.data.title} />
          </div>
        </div>
      </div>
    </div>
    <PostFeedback
      title="Was this post helpful?"
      firstChoice="Yes"
      secondChoice="No"
    />
  </section>

  <!--Related articles. Three tag-matched posts, not every other article on
      the site: this section used to render all thirteen, each with its own
      image, which roughly doubled the weight of every post page.-->
  {
    relatedPosts.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <h2 class="mb-8 text-2xl font-bold md:text-3xl">Related articles</h2>

        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3">
          {relatedPosts.map((entry) => (
            <CardRelated blogEntry={entry} />
          ))}
        </div>
      </section>
    )
  }
</MainLayout>
