---
// Import necessary components, modules and types
import MainLayout from "@/layouts/MainLayout.astro";
import CardBlog from "@components/ui/cards/CardBlog.astro";
import CardBlogRecent from "@components/ui/cards/CardBlogRecent.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { SITE } from "@data/constants";

// Get all blogs post and sort them based on publish date
const blogPosts = (await getCollection("blog")) as CollectionEntry<"blog">[];
blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Separate the most recent post from others, with safe fallbacks
const mostRecentPost: CollectionEntry<"blog"> | undefined = blogPosts[0];
const otherPosts: CollectionEntry<"blog">[] = blogPosts.length > 1 ? blogPosts.slice(1) : [];

// Define variables for page content
const title: string = "Food Insecurity in Philadelphia: Articles and Updates";
const subTitle: string =
  "Discover stories, updates, and insights on our mission to fight food insecurity in Philadelphia. Learn about our initiatives, community impact, and how you can get involved.";

const pageTitle: string = `Food Insecurity in Philadelphia: Articles | ${SITE.title}`;

// Create Open Graph metadata for the blog index page
const ogMeta = {
  title: title,
  description: subTitle,
  image: mostRecentPost?.data.cardImage || mostRecentPost?.data.authorImage,
  url: Astro.url.origin + Astro.url.pathname
};
---

<MainLayout
  title={pageTitle}
  meta={subTitle}
  ogMeta={ogMeta}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": "https://feedphillycoalition.org/blog",
      url: "https://feedphillycoalition.org/blog",
      name: "Food Insecurity in Philadelphia: Articles",
      description: subTitle,
      inLanguage: "en-US",
      about: { "@id": "https://feedphillycoalition.org/#organization" },
      isPartOf: {
        "@type": "WebSite",
        "@id": "https://feedphillycoalition.org/#website",
        url: "https://feedphillycoalition.org",
        name: "Feed Philly Coalition",
      },
      // Listing the articles explicitly helps search and answer engines see
      // this as a real index rather than a page of card markup.
      mainEntity: {
        "@type": "ItemList",
        itemListElement: blogPosts.slice(0, 20).map((post, index) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `https://feedphillycoalition.org/blog/${post.id}/`,
          name: post.data.title,
        })),
      },
    },
  ]}
>
  <section class="mx-auto max-w-[85rem] px-4 pt-14 sm:px-6 lg:px-8">
    <!--Page header-->
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <h1 class="text-balance">
        {title}
      </h1>

      <p class="lede mt-4">
        {subTitle}
      </p>
    </div>
  </section>

  {
    blogPosts.length === 0 ? (
      <section class="section-tight">
        <div class="text-center">
          <p class="text-lg text-neutral-600 dark:text-neutral-400">
            No blog posts available at the moment. Check back soon!
          </p>
        </div>
      </section>
    ) : (
      <>
        {/* The newest article leads the page. It used to sit at the very
            bottom, below thirteen other cards. */}
        {mostRecentPost && (
          <section class="section-tight">
            <CardBlogRecent blogEntry={mostRecentPost} />
          </section>
        )}
        <section class="section-tight">
          <h2 class="mb-8 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
            More articles
          </h2>
          <!--Blog posts grid-->
          <div class="grid gap-6 lg:grid-cols-2">
            {otherPosts.map((blogEntry, index) => (
              <CardBlog blogEntry={blogEntry} eager={index < 2} />
            ))}
          </div>
        </section>
      </>
    )
  }
</MainLayout>
