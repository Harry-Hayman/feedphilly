---
import MainLayout from "@/layouts/MainLayout.astro";
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import { Image } from 'astro:assets';
import donationImage from "@images/real_images/20250212_104744.jpeg";
import teamImage from "@images/real_images/IMG_0483.jpeg";

const waysToHelp = [
  {
    title: "Advocate",
    description: "Join our coalition to support policy change and raise awareness about food insecurity in Philadelphia.",
    image: teamImage,
    imageAlt: "Feed Philly Coalition volunteers in branded shirts gathered together",
    cta: "Sign Up to Advocate",
    link: "/contact?type=advocate"
  },
  {
    title: "Collaborate",
    description: "Partner with us and other organizations to create positive, sustainable impact through community initiatives and policy making.",
    image: donationImage,
    imageAlt: "Volunteers packing boxes of food for distribution",
    cta: "Become a Partner",
    link: "/contact?type=partner"
  }
];
---

<MainLayout
  title="Get Involved: Help Fight Food Insecurity in Philadelphia | Feed Philly Coalition"
  meta="Advocate, partner, or spread the word. Practical ways to help Feed Philly Coalition address food insecurity in Philadelphia, whether you are an individual, a nonprofit or a business."
>
  <section class="section">
    <!-- This page previously had no <h1> at all: it opened on an <h2>. -->
    <div class="section-header">
      <h1 class="text-balance">Make a Difference in Philadelphia</h1>
      <p class="lede mt-4">
        This is a movement, and there is room for you in it. Advocate, partner
        with us, or help spread the word. Every one of those moves the work
        forward.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      {waysToHelp.map((way, index) => (
        <div class="group flex flex-col overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm transition hover:shadow-md dark:border-neutral-700 dark:bg-neutral-800">
          <Image
            src={way.image}
            alt={way.imageAlt}
            class="h-[220px] w-full object-cover"
            width={640}
            height={220}
            widths={[480, 640, 900]}
            sizes="(min-width: 1024px) 32rem, 92vw"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            format="avif"
          />
          <div class="flex flex-1 flex-col p-6">
            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
              {way.title}
            </h2>
            <p class="mt-3 flex-1 text-neutral-700 dark:text-neutral-300">
              {way.description}
            </p>
            <div class="mt-6">
              <PrimaryCTA title={way.cta} url={way.link} />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mx-auto mt-16 max-w-2xl text-center">
      <h2 class="text-2xl font-bold">Other Ways to Support</h2>
      <p class="mt-4 text-neutral-700 dark:text-neutral-300">
        You can also support our mission by:
      </p>
      <!-- These were bullet characters inside a <p> separated by <br>, which
           reads as one run-on sentence to a screen reader. -->
      <ul class="mx-auto mt-4 inline-block list-disc space-y-2 text-left text-neutral-700 marker:text-green-700 dark:text-neutral-300 dark:marker:text-green-400">
        <li>Spreading awareness on social media</li>
        <li>Supporting policy initiatives</li>
        <li>Building partnerships with organizations</li>
      </ul>
      <div class="mt-8">
        <PrimaryCTA title="Contact Us to Learn More" url="/contact" />
      </div>
    </div>
  </section>
</MainLayout>
